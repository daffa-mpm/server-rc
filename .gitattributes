# Default: let Git normalise text in the repository to LF.
* text=auto eol=lf

# These are consumed on a Linux server. CRLF breaks the shebang
# ("bad interpreter: /usr/bin/env bash^M") and Dockerfile RUN lines,
# so pin them regardless of anyone's core.autocrlf setting.
*.sh        text eol=lf
*.mjs       text eol=lf
*.ts        text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
Dockerfile  text eol=lf
.env.example text eol=lf

# Keep the lockfile out of diffs and language stats.
package-lock.json -diff linguist-generated
