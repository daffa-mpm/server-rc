# ---------------------------------------------------------------------------
# server-remote-control configuration
#
# Copy to .env and edit. The only required value is RC_TOKEN.
#   cp .env.example .env && sed -i "s|^RC_TOKEN=.*|RC_TOKEN=$(openssl rand -hex 32)|" .env
# ---------------------------------------------------------------------------

# REQUIRED. Shared bearer token, minimum 32 characters. Anyone holding this has
# root on this host. Generate with: openssl rand -hex 32
RC_TOKEN=

# Friendly name for this host, shown to Claude in tool descriptions.
# Defaults to the container hostname.
#RC_SERVER_LABEL=prod-app-01

# --- Network -----------------------------------------------------------------
#RC_PORT=8723
#RC_BIND=0.0.0.0
#RC_MCP_PATH=/mcp
# Comma-separated hostnames allowed in the Host header (DNS-rebinding protection).
# Set this to your public hostname once you know it.
#RC_ALLOWED_HOSTS=server.example.com
# Trust X-Forwarded-For from the reverse proxy, so audit logs show the real client IP.
#RC_TRUST_PROXY=true

# --- Capabilities ------------------------------------------------------------
# Which tool groups to expose. Trim this to reduce what Claude can reach.
#RC_TOOLSETS=shell,files,docker,system

# Refuse every tool that modifies the host. Start here if you want to try it safely.
#RC_READONLY=false

# Restrict file tools to these roots (colon-separated). Default "/" is everything.
# Narrowing this is the single most effective way to limit blast radius.
#RC_ALLOWED_PATHS=/srv:/etc/nginx:/var/log
#RC_DENIED_PATHS=/root/.ssh:/etc/shadow

# delete_path is disabled unless you turn it on.
#RC_ALLOW_DELETE=false
# systemctl start/stop/restart/enable/disable.
#RC_ALLOW_SERVICE_CONTROL=true

# --- Execution ---------------------------------------------------------------
# nsenter  = run commands on the host (needs pid:host + privileged). The useful mode.
# container = keep commands inside this container, host filesystem under RC_HOST_ROOT.
#RC_EXEC_MODE=nsenter
#RC_HOST_ROOT=/host
#RC_SHELL=/bin/bash

#RC_DEFAULT_TIMEOUT_SEC=60
#RC_MAX_TIMEOUT_SEC=900
# Output above this is truncated head+tail, to protect Claude's context window.
#RC_MAX_OUTPUT_BYTES=100000

# --- Guard rails -------------------------------------------------------------
# Extra blocked command patterns, one regex per line. These add to the built-in list
# (rm -rf /, mkfs, dd to a raw disk, fork bombs, shutdown/reboot).
#RC_BLOCKED_COMMAND_PATTERNS=
# Remove the built-in list entirely. Not recommended.
#RC_DISABLE_COMMAND_GUARD=false

# --- Audit -------------------------------------------------------------------
# Every tool call is logged to stdout as JSON. Set this to also append to a file.
# The log contains command text and file contents: treat it as sensitive.
#RC_AUDIT_FILE=/host/var/log/remote-control-audit.jsonl
